# 覆盖率门禁用的配置：父进程写主数据文件，子进程用 `-p` 写 partial。
#
# 为什么不用 pyproject 的 parallel=true：`coverage combine` 从空数据对象重建
# （control.py 的 `_init_data` 只在 `_data is None` 时创建、`combine()` 不读已存在的
# `.coverage`），父进程的 partial 在整轮跑里会丢，报出 79% 的假低值。
# 让父进程非并行地写 `.coverage`，再跑 `coverage report`（它会把子进程的 partial
# 折进来并清掉），得到的是并集。
#
# 跑法：
#   coverage erase
#   coverage run --rcfile=coverage.rc -m pytest tests/ ...
#   coverage report --fail-under=95
[run]
source = mini_harness
parallel = false
